# SELECT
#     NAME,
#     COUNT(ANIMAL_ID) AS count
# FROM ANIMAL_INS
# WHERE
#     NAME IS NOT NULL
# GROUP BY
#     NAME
# HAVING
#     count >= 2
# ORDER BY
#     NAME

SELECT
    NAME,
    COUNT(*) AS cnt
FROM ANIMAL_INS
WHERE
    1=1
    AND NAME IS NOT NULL
GROUP BY
    NAME
HAVING
    cnt >= 2
ORDER BY
    NAME















